# Copy to infra/cloudrun/secrets.env (gitignored). deploy.sh pushes each line into Secret Manager
# as a new secret version and wires it into the service with --set-secrets.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/landstack?ssl=require
EVENTS_SHARED_SECRET=replace-with-openssl-rand-hex-32
REPORT_HMAC_SECRET=replace-with-openssl-rand-hex-32
GEMINI_API_KEY=
