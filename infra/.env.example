# Compose-level variables (copy to infra/.env). App-level settings live in apps/api/.env and apps/web/.env.
COMPOSE_PROJECT_NAME=landstack
POSTGRES_USER=landstack
POSTGRES_PASSWORD=landstack
POSTGRES_DB=landstack
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
WEB_PROD_PORT=8080
MARTIN_PORT=3000
# 1 = the one-shot `migrate` service also seeds when landstack.parcels is empty; 0 = migrations only
SEED_ON_UP=1
