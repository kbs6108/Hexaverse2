# Compose-level variables (copy to infra/.env). App-level settings live in apps/api/.env and apps/web/.env.
COMPOSE_PROJECT_NAME=tract
POSTGRES_USER=tract
POSTGRES_PASSWORD=tract
POSTGRES_DB=tract
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
WEB_PROD_PORT=8080
MARTIN_PORT=3000
# 1 = the one-shot `migrate` service also seeds when tract.parcels is empty; 0 = migrations only
SEED_ON_UP=1
